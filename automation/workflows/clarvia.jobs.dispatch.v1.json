      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Compute HMAC auth headers for the Claim Jobs request.\n// Secret is stored in n8n environment variable.\n\nconst crypto = require('crypto');\n\nconst timestamp = new Date().toISOString();\nconst body = JSON.stringify({ worker: 'n8n-dispatcher', limit: 10 });\nconst secret = $env.CLARVIA_INTERNAL_HMAC_SECRET;\n\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.' + body)\n  .digest('hex');\n\nreturn [{\n  json: {\n    claimAuth: {\n      timestamp,\n      signature,\n      body\n    }\n  }\n}];"
      },
