    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compute HMAC auth headers for the current job's API call.\n// Per blueprint §5.3: HMAC-SHA256(secret, timestamp + \".\" + rawBody)\n\nconst crypto = require('crypto');\n\nconst jobId = $json.id;\nconst timestamp = new Date().toISOString();\nconst body = JSON.stringify({ jobId });\nconst secret = $env.CLARVIA_INTERNAL_HMAC_SECRET;\n\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.' + body)\n  .digest('hex');\n\nreturn {\n  json: {\n    ...$json,\n    auth: {\n      timestamp,\n      signature,\n      body,\n      jobId\n    }\n  }\n};"
      },
